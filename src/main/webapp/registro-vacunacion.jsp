<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Registro de vacunación | IPS Farallones</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body><main class="contenedor">
<header class="encabezado"><h1>IPS Preventiva Farallones</h1><h2>Registro de vacunación aplicada</h2></header><nav class="navegacion"><a href="${pageContext.request.contextPath}/">Inicio</a><a class="activo" href="${pageContext.request.contextPath}/registro-vacunacion">Vacunaciones</a></nav>
<c:if test="${not empty error}"><p class="mensaje error" role="alert"><c:out value="${error}"/></p></c:if>
<section class="tarjeta"><h2>Registrar aplicación</h2><p class="texto-intro">Solo aparecen citas programadas cuya fecha ya llegó. Al guardar, se descuenta una dosis y la cita pasa a Atendida dentro de la misma transacción.</p>
<c:choose><c:when test="${empty citasPendientes}"><p class="sin-registros">No hay citas programadas elegibles. Revise que estén vinculadas al catálogo y que su fecha ya haya llegado.</p></c:when><c:otherwise><form method="post" class="formulario"><input type="hidden" name="csrfToken" value="${csrfToken}">
<div class="campo"><label for="idCita">Cita programada</label><select id="idCita" name="idCita" required><option value="">Seleccione una cita</option><c:forEach var="c" items="${citasPendientes}"><option value="${c.idCita}">#<c:out value="${c.idCita}"/> — <c:out value="${c.paciente}"/> — <c:out value="${c.vacuna}"/> — <c:out value="${c.fechaHora}"/></option></c:forEach></select></div>
<c:if test="${empty usuarioActual.idPersonal}"><div class="campo"><label for="idPersonal">Profesional que aplica</label><select id="idPersonal" name="idPersonal" required><option value="">Seleccione</option><c:forEach var="p" items="${personalActivo}"><option value="${p.idPersonal}"><c:out value="${p.nombres}"/> <c:out value="${p.apellidos}"/> — <c:out value="${p.cargo}"/></option></c:forEach></select></div></c:if>
<div class="campo"><label for="numeroDosis">Número de dosis</label><input id="numeroDosis" name="numeroDosis" type="number" min="1" max="255" required></div><div class="campo"><label for="lote">Lote de la vacuna</label><input id="lote" name="lote" maxlength="60" required></div>
<div class="campo"><label for="fechaAplicacion">Fecha y hora de aplicación</label><input id="fechaAplicacion" name="fechaAplicacion" type="datetime-local" required></div><div class="campo campo-completo"><label for="observaciones">Observaciones</label><textarea id="observaciones" name="observaciones" maxlength="500" rows="3"></textarea></div>
<div class="campo campo-completo"><button type="submit">Guardar aplicación</button></div></form></c:otherwise></c:choose></section>
<section class="tarjeta"><h2>Historial de aplicaciones</h2><div class="tabla-contenedor"><table><thead><tr><th>Fecha</th><th>Paciente</th><th>Vacuna</th><th>Dosis</th><th>Lote</th><th>Profesional</th><th>Cita</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><c:out value="${r.fechaAplicacion}"/></td><td><c:out value="${r.paciente}"/></td><td><c:out value="${r.vacuna}"/></td><td><c:out value="${r.numeroDosis}"/></td><td><c:out value="${r.lote}"/></td><td><c:out value="${r.personal}"/></td><td>#<c:out value="${r.idCita}"/></td></tr></c:forEach><c:if test="${empty registros}"><tr><td colspan="7" class="sin-registros">Todavía no hay aplicaciones registradas.</td></tr></c:if></tbody></table></div></section>
<footer class="pie">Este módulo registra la aplicación efectivamente realizada y conserva su trazabilidad.</footer></main></body></html>
