<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Personal de salud | IPS Farallones</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head>
<body><main class="contenedor">
<header class="encabezado"><h1>IPS Preventiva Farallones</h1><h2>Administración del personal de salud</h2></header>
<nav class="navegacion"><a href="${pageContext.request.contextPath}/">Inicio</a><a href="${pageContext.request.contextPath}/usuarios">Usuarios</a><a class="activo" href="${pageContext.request.contextPath}/personal">Personal</a><a href="${pageContext.request.contextPath}/registro-vacunacion">Vacunaciones</a><a href="${pageContext.request.contextPath}/logout">Cerrar sesión</a></nav>
<c:if test="${not empty error}"><p class="mensaje error" role="alert"><c:out value="${error}"/></p></c:if>
<section class="tarjeta"><h2>Registrar profesional</h2>
<form method="post" class="formulario"><input type="hidden" name="csrfToken" value="${csrfToken}">
<div class="campo"><label for="tipoDocumento">Tipo de documento</label><select id="tipoDocumento" name="tipoDocumento" required><option value="">Seleccione</option><option>CC</option><option>CE</option><option>PEP</option><option>Pasaporte</option></select></div>
<div class="campo"><label for="numeroDocumento">Número de documento</label><input id="numeroDocumento" name="numeroDocumento" required maxlength="30"></div>
<div class="campo"><label for="registroProfesional">Registro profesional</label><input id="registroProfesional" name="registroProfesional" required maxlength="50"></div>
<div class="campo"><label for="nombres">Nombres</label><input id="nombres" name="nombres" required maxlength="100"></div><div class="campo"><label for="apellidos">Apellidos</label><input id="apellidos" name="apellidos" required maxlength="100"></div>
<div class="campo"><label for="cargo">Cargo</label><input id="cargo" name="cargo" required maxlength="80" placeholder="Enfermero/a, médico/a..."></div><div class="campo"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" maxlength="30"></div><div class="campo campo-completo"><button type="submit">Guardar personal</button></div></form></section>
<c:if test="${not empty edicion}"><section class="tarjeta"><h2>Editar profesional</h2>
<form method="post" class="formulario"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="accion" value="actualizar"><input type="hidden" name="idPersonal" value="${edicion.idPersonal}">
<div class="campo"><label for="editTipoDocumento">Tipo de documento</label><select id="editTipoDocumento" name="tipoDocumento" required><option value="CC" ${edicion.tipoDocumento == 'CC' ? 'selected' : ''}>CC</option><option value="CE" ${edicion.tipoDocumento == 'CE' ? 'selected' : ''}>CE</option><option value="PEP" ${edicion.tipoDocumento == 'PEP' ? 'selected' : ''}>PEP</option><option value="Pasaporte" ${edicion.tipoDocumento == 'Pasaporte' ? 'selected' : ''}>Pasaporte</option></select></div>
<div class="campo"><label for="editNumeroDocumento">Número de documento</label><input id="editNumeroDocumento" name="numeroDocumento" value="${edicion.numeroDocumento}" required maxlength="30"></div>
<div class="campo"><label for="editRegistroProfesional">Registro profesional</label><input id="editRegistroProfesional" name="registroProfesional" value="${edicion.registroProfesional}" required maxlength="50"></div>
<div class="campo"><label for="editNombres">Nombres</label><input id="editNombres" name="nombres" value="${edicion.nombres}" required maxlength="100"></div><div class="campo"><label for="editApellidos">Apellidos</label><input id="editApellidos" name="apellidos" value="${edicion.apellidos}" required maxlength="100"></div>
<div class="campo"><label for="editCargo">Cargo</label><input id="editCargo" name="cargo" value="${edicion.cargo}" required maxlength="80"></div><div class="campo"><label for="editTelefono">Teléfono</label><input id="editTelefono" name="telefono" value="${edicion.telefono}" maxlength="30"></div><div class="campo campo-completo"><button type="submit">Guardar cambios</button> <a class="enlace-volver" href="${pageContext.request.contextPath}/personal">Cancelar</a></div></form></section></c:if>
<section class="tarjeta"><h2>Personal registrado</h2><div class="tabla-contenedor"><table><thead><tr><th>Documento</th><th>Nombre</th><th>Registro</th><th>Cargo</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<c:forEach var="p" items="${personal}"><tr><td><c:out value="${p.tipoDocumento}"/> <c:out value="${p.numeroDocumento}"/></td><td><c:out value="${p.nombres}"/> <c:out value="${p.apellidos}"/></td><td><c:out value="${p.registroProfesional}"/></td><td><c:out value="${p.cargo}"/></td><td><c:out value="${p.telefono}"/></td><td><c:out value="${p.activo ? 'Activo' : 'Inactivo'}"/></td>
<td><div class="acciones"><a class="boton" href="${pageContext.request.contextPath}/personal?id=${p.idPersonal}">Editar</a><form method="post"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="accion" value="estado"><input type="hidden" name="idPersonal" value="${p.idPersonal}"><input type="hidden" name="activo" value="${!p.activo}"><button type="submit"><c:out value="${p.activo ? 'Desactivar' : 'Activar'}"/></button></form></div></td></tr></c:forEach>
<c:if test="${empty personal}"><tr><td colspan="7" class="sin-registros">No hay personal registrado.</td></tr></c:if></tbody></table></div></section>
<footer class="pie">Al desactivar un profesional, también se desactiva su usuario vinculado.</footer></main></body></html>
