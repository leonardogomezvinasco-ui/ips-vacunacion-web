<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Usuarios | IPS Farallones</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body><main class="contenedor">
<header class="encabezado"><h1>IPS Preventiva Farallones</h1><h2>Cuentas y permisos</h2></header><nav class="navegacion"><a href="${pageContext.request.contextPath}/">Inicio</a><a class="activo" href="${pageContext.request.contextPath}/usuarios">Usuarios</a><a href="${pageContext.request.contextPath}/personal">Personal</a><a href="${pageContext.request.contextPath}/logout">Cerrar sesión</a></nav>
<c:if test="${not empty error}"><p class="mensaje error" role="alert"><c:out value="${error}"/></p></c:if>
<section class="tarjeta"><h2>Crear cuenta</h2><p class="texto-intro">Asigne únicamente el rol necesario. El rol de personal de salud se vincula con un profesional activo.</p><form method="post" class="formulario"><input type="hidden" name="csrfToken" value="${csrfToken}">
<div class="campo"><label for="nombreUsuario">Nombre de usuario</label><input id="nombreUsuario" name="nombreUsuario" required minlength="3" maxlength="60" pattern="[A-Za-z0-9._-]+" autocomplete="off"></div>
<div class="campo"><label for="contrasena">Contraseña inicial</label><input id="contrasena" name="contrasena" type="password" required minlength="12" autocomplete="new-password"><small>Mínimo 12 caracteres. Se guarda como hash PBKDF2.</small></div>
<div class="campo"><label for="rol">Rol</label><select id="rol" name="rol" required><option value="AUXILIAR">Auxiliar</option><option value="PERSONAL_SALUD">Personal de salud</option><option value="ADMINISTRADOR">Administrador</option></select></div>
<div class="campo"><label for="idPersonal">Profesional asociado</label><select id="idPersonal" name="idPersonal"><option value="">No aplica</option><c:forEach var="p" items="${personalActivo}"><option value="${p.idPersonal}"><c:out value="${p.nombres}"/> <c:out value="${p.apellidos}"/> — <c:out value="${p.registroProfesional}"/></option></c:forEach></select></div>
<div class="campo campo-completo"><button type="submit">Crear cuenta</button></div></form></section>
<section class="tarjeta"><h2>Cuentas existentes</h2><div class="tabla-contenedor"><table><thead><tr><th>Usuario</th><th>Rol</th><th>Personal asociado</th><th>Estado</th><th>Acción</th></tr></thead><tbody><c:forEach var="u" items="${usuarios}"><tr><td><c:out value="${u.nombreUsuario}"/></td><td><c:out value="${u.rol}"/></td><td><c:out value="${empty u.nombrePersonal ? '—' : u.nombrePersonal}"/></td><td><c:out value="${u.activo ? 'Activo' : 'Inactivo'}"/></td><td><form method="post" class="acciones"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="accion" value="estado"><input type="hidden" name="idUsuario" value="${u.idUsuario}"><input type="hidden" name="activo" value="${!u.activo}"><button type="submit"><c:out value="${u.activo ? 'Desactivar' : 'Activar'}"/></button></form></td></tr></c:forEach><c:if test="${empty usuarios}"><tr><td colspan="5" class="sin-registros">No hay cuentas registradas. Cree el primer administrador según las instrucciones de instalación.</td></tr></c:if></tbody></table></div></section>
<footer class="pie">El primer administrador se provisiona por base de datos usando un hash generado por la utilidad del proyecto.</footer></main></body></html>
